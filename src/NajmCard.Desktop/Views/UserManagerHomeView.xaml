<UserControl x:Class="NajmCard.Desktop.Views.UserManagerHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft" FontFamily="Arial"
    Background="Transparent" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HubBanner" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4E3D7" Offset="0"/>
            <GradientStop Color="#FFF8EC" Offset="0.55"/>
            <GradientStop Color="#DFC0B0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HubIcon" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#621B37" Offset="0"/>
            <GradientStop Color="#270C19" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HubCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CreamPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" CornerRadius="19" BorderThickness="1.2"
                                BorderBrush="{StaticResource LineBrush}" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" ClipToBounds="True">
                            <Grid>
                                <Path Data="M 0,36 Q 55,25 142,0 L 142,36 Z"
                                      Fill="{StaticResource GoldBrush}" Stretch="Fill" Width="142" Height="36"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                      IsHitTestVisible="False" Opacity="0.9"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFF0D7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#BE9048"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F4E3D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HubIconFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HubIcon}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HubCardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="HubCardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource LineBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,5,0,7"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource CreamPanelBrush}" BorderBrush="{StaticResource MaroonLineBrush}" BorderThickness="1"
            CornerRadius="18" Padding="12" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="17" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Background="{StaticResource HubBanner}"
                    Margin="5,4,5,8" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.ColumnSpan="2" Data="M 0,110 C 90,10 155,130 310,45 C 380,15 430,25 520,0"
                          Stroke="{StaticResource GoldBrush}" StrokeThickness="12" Opacity="0.24"
                          Stretch="Fill" VerticalAlignment="Bottom" Height="110"
                          IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="0" Margin="21,12,12,9" VerticalAlignment="Center">
                        <TextBlock Text="إدارة User Manager" FontWeight="Bold" FontSize="31"
                                   Foreground="{StaticResource CreamTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="إدارة بيانات المستخدمين والباقات والجلسات والتقارير"
                                   FontSize="15" Foreground="{StaticResource LineBrush}" Margin="0,9,0,0"
                                   TextWrapping="Wrap"/>
                        <Border Background="{StaticResource GoldBrush}" Width="128" Height="5"
                                CornerRadius="3" HorizontalAlignment="Right" Margin="0,11,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="18" CornerRadius="17"
                            Background="{StaticResource HubIcon}" BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Ellipse Width="87" Height="87" Fill="{StaticResource BurgundyBrush}" Opacity="0.3"/>
                            <Path Data="{StaticResource IconServer}" Stroke="{StaticResource TextBrush}" StrokeThickness="2.3"
                                  Stretch="Uniform" Width="70" Height="70" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,3,0,2">
                <Button Tag="users" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="{StaticResource IconPeople}" Stroke="White" StrokeThickness="2"
                                  Width="45" Height="45" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="إدارة المستخدمين" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="الكروت والحسابات" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
                <Button Tag="packages" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="{StaticResource IconPackages}" Stroke="White" StrokeThickness="2"
                                  Width="45" Height="45" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="إدارة الباقات" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="Profiles و Limitations" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
                <Button Tag="sessions" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="{StaticResource IconSignal}" Stroke="White" StrokeThickness="2"
                                  Width="45" Height="45" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="الجلسات" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="الاتصالات والاستهلاك" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
            </UniformGrid>
            <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,2,0,3">
                <Button Tag="search" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="M 20,12 A 9,9 0 1 1 2,12 A 9,9 0 1 1 20,12 M 18,19 L 28,29"
                                  Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="Uniform" Width="45" Height="45"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="البحث المتقدم" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="فلاتر دقيقة وسريعة" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
                <Button Tag="reports" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="{StaticResource IconReport}" Stroke="White" StrokeThickness="2"
                                  Width="45" Height="45" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="التقارير" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="إحصائيات الكروت" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
                <Button Tag="maintenance" Click="Card_Click" Style="{StaticResource HubCardButton}" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource HubIconFrame}" Grid.Row="0">
                            <Path Data="{StaticResource IconRefresh}" Stroke="White" StrokeThickness="2"
                                  Width="45" Height="45" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="النسخ والصيانة" Style="{StaticResource HubCardTitle}"/>
                        <TextBlock Grid.Row="2" Text="النسخ والاستعادة" Style="{StaticResource HubCardSubtitle}"/>
                        <TextBlock Grid.Row="3" Text="❮" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource MaroonLineBrush}" HorizontalAlignment="Left" Margin="5,0"/>
                    </Grid>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
